FROM golang:1.26.0-bookworm@sha256:2a0ba12e116687098780d3ce700f9ce3cb340783779646aafbabed748fa6677c AS builder

WORKDIR /src/mcp
COPY shared ./shared
COPY brain/go.mod brain/go.sum ./brain/
WORKDIR /src/mcp/brain
RUN go mod download

WORKDIR /src/mcp
COPY brain ./brain
WORKDIR /src/mcp/brain
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN CGO_ENABLED=1 go build -tags duckdb -o /out/brain ./cmd/brain

ARG SIDECAR_IMAGE
FROM ${SIDECAR_IMAGE} AS sidecar

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1000 app \
    && useradd -u 1000 -g app -m app \
    && mkdir -p /app/configs /app/logs /var/lib/brain /var/mcp/credentials /tmp

COPY --chmod=755 --from=builder /out/brain /usr/local/bin/brain
COPY --chown=app:app --from=builder /src/mcp/brain/configs /app/configs
COPY --chmod=755 --from=builder /src/mcp/brain/docker/run-brain-stdio.sh /usr/local/bin/run-brain-stdio.sh
COPY --chmod=755 --from=sidecar /usr/local/bin/mcp_sidecar /usr/local/bin/mcp-sidecar

RUN chown -R app:app /app /var/lib/brain /var/mcp /tmp

WORKDIR /app
USER app

ENV BRAIN_BASE_DIR=/var/lib/brain
ENV BRAIN_STORAGE_BACKEND=duckdb
ENV BRAIN_EMBEDDING_PROVIDER=none
ENV TMPDIR=/tmp
ENV MCP_SIDECAR_CREDENTIALS_PATH=/var/mcp/credentials
ENV MCP_SIDECAR_LOCAL_MCP_TRANSPORT=stdio
ENV MCP_SIDECAR_LOCAL_MCP_COMMAND=/usr/local/bin/run-brain-stdio.sh
ENV MCP_SIDECAR_MCP_TYPE=brain
ENV MCP_SIDECAR_LOG_LEVEL=info
ENV MCP_SIDECAR_LOG_ENCODING=json

ENTRYPOINT ["/usr/local/bin/mcp-sidecar", "start"]
