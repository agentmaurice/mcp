<!-- Fragment partage (profil message) : pied d'e-mail avec desabonnement. -->
<mj-section background-color="{{ .brand.colors.background }}" padding="16px 24px">
  <mj-column>
    <mj-text font-family="{{ .brand.fonts.body.family }}" font-size="12px" color="{{ .brand.colors.muted }}">
      {{ .company.legal_name }} - {{ .company.address.line1 }}, {{ .company.address.postal_code }} {{ .company.address.city }}
    </mj-text>
    <mj-text font-family="{{ .brand.fonts.body.family }}" font-size="12px" color="{{ .brand.colors.muted }}">
      <a href="{{ .data.unsubscribe_url }}">{{ .i18n.strings.common_unsubscribe }}</a>
    </mj-text>
  </mj-column>
</mj-section>
