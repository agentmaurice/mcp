{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Donnees metier du devis",
  "description": "Montants fournis en amont sous forme de chaines deja formatees : le gabarit affiche, il ne calcule pas d'argent.",
  "type": "object",
  "required": ["reference", "customer", "lines", "totals", "valid_until", "terms", "payment_terms"],
  "properties": {
    "reference": { "type": "string", "minLength": 1 },
    "customer": {
      "type": "object",
      "required": ["name", "address_lines", "contact"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address_lines": { "type": "array", "items": { "type": "string" } },
        "contact": { "type": "string" }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "quantity", "unit_price_ht", "vat_rate", "total_ht"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "quantity": { "type": "string", "description": "Quantite et unite, par exemple `3 jours`." },
          "unit_price_ht": { "$ref": "#/$defs/money" },
          "vat_rate": { "type": "string", "pattern": "^[0-9]+([,.][0-9]+)? ?%$" },
          "total_ht": { "$ref": "#/$defs/money" }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["total_ht", "vat", "total_ttc"],
      "properties": {
        "total_ht": { "$ref": "#/$defs/money" },
        "vat": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rate", "amount"],
            "properties": {
              "rate": { "type": "string" },
              "amount": { "$ref": "#/$defs/money" }
            }
          }
        },
        "total_ttc": { "$ref": "#/$defs/money" }
      }
    },
    "valid_until": { "type": "string", "format": "date" },
    "terms": { "type": "array", "items": { "type": "string" } },
    "payment_terms": { "type": "string" }
  },
  "$defs": {
    "money": {
      "type": "string",
      "pattern": "^-?[0-9][0-9 ]*,[0-9]{2} (EUR|€)$",
      "description": "Montant formate en amont, par exemple `1 250,00 €`."
    }
  }
}
