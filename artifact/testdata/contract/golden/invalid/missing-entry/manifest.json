{
  "schema": "agentmaurice.template/v1",
  "key": "quote",
  "version": "1.0.0",
  "title": "Devis",
  "description": "Devis avec lignes, quantités, prix unitaire HT, TVA, totaux fournis en amont, conditions et validité.",
  "kind": "document",
  "profile": "document",
  "source": { "engine": "typst", "entry": "main.typ" },
  "outputs": ["pdf"],
  "locales": ["fr"],
  "default_locale": "fr",
  "input_schema": "input.schema.json",
  "examples": [{ "name": "default", "data": "examples/default.json" }],
  "fragments": [
    "fragments/header.typ",
    "fragments/footer.typ",
    "fragments/legal-mentions.typ",
    "fragments/lines-table.typ"
  ],
  "limits": { "max_source_bytes": 20000, "max_pages": 4 }
}
