# SIDECAR_IMAGE: mcp-sidecar base image (declared before the first FROM to be usable in one).
ARG SIDECAR_IMAGE

FROM golang:1.26.0-bookworm@sha256:2a0ba12e116687098780d3ce700f9ce3cb340783779646aafbabed748fa6677c AS builder

WORKDIR /src/mcp
COPY shared ./shared
COPY artifact/go.mod artifact/go.sum ./artifact/
WORKDIR /src/mcp/artifact
RUN go mod download

WORKDIR /src/mcp
COPY artifact ./artifact
WORKDIR /src/mcp/artifact
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/artifact ./cmd/artifact

FROM ${SIDECAR_IMAGE} AS sidecar

# Typst 0.15.1 (bench AGENT-1573): official static release, SHA-256 verified.
FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818 AS typst
ARG TARGETARCH
ARG TYPST_VERSION=0.15.1
ARG TYPST_SHA256_AMD64=a6d077d0a95eed5a2eba715b2dae06be954f624ccbf85758a03f389ded33118c
ARG TYPST_SHA256_ARM64=5aa8d74a3d906e60ea12a66ac2f37f8eef1b14cbad7182a745e393a10c23dcee
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) triple=x86_64-unknown-linux-musl; sha="${TYPST_SHA256_AMD64}" ;; \
      arm64) triple=aarch64-unknown-linux-musl; sha="${TYPST_SHA256_ARM64}" ;; \
      *) echo "unsupported architecture ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSLo /tmp/typst.tar.xz "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-${triple}.tar.xz"; \
    echo "${sha}  /tmp/typst.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/typst.tar.xz -C /tmp; \
    install -m 0755 "/tmp/typst-${triple}/typst" /usr/local/bin/typst; \
    mkdir -p /usr/share/doc/typst; \
    cp "/tmp/typst-${triple}/LICENSE" "/tmp/typst-${triple}/NOTICE" /usr/share/doc/typst/

# MJML 5.4.1 (bench AGENT-1614): the Node binary of this pinned official image, and
# node_modules installed from the committed lockfile (docker/mjml). The network is
# used here, at build time only; scripts of dependencies never run.
FROM node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS mjml
WORKDIR /opt/mjml
COPY artifact/docker/mjml/package.json artifact/docker/mjml/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY artifact/docker/mjml/render.mjs ./

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

# fonts-liberation2: free fonts (Arial/Helvetica metrics) next to Typst's embedded
# Libertinus Serif, New Computer Modern and DejaVu Sans Mono.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates fonts-liberation2 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 app \
    && useradd -u 1000 -g app -m app \
    && mkdir -p /app /var/mcp/credentials /tmp \
    && chown -R app:app /app /var/mcp /tmp

COPY --chmod=755 --from=builder /out/artifact /usr/local/bin/artifact
COPY --chmod=755 --from=builder /src/mcp/artifact/docker/run-artifact-stdio.sh /usr/local/bin/run-artifact-stdio.sh
COPY --chmod=755 --from=typst /usr/local/bin/typst /usr/local/bin/typst
COPY --from=typst /usr/share/doc/typst /usr/share/doc/typst
# Node (same Debian release as this base: libstdc++ and glibc match) and MJML, with their licenses.
COPY --chmod=755 --from=mjml /usr/local/bin/node /usr/local/bin/node
COPY --from=mjml /usr/local/LICENSE /usr/share/doc/node/LICENSE
COPY --from=mjml /opt/mjml /opt/mjml
COPY --from=mjml /opt/mjml/node_modules/mjml/LICENSE.md /usr/share/doc/mjml/LICENSE.md
COPY --chmod=755 --from=sidecar /usr/local/bin/mcp_sidecar /usr/local/bin/mcp-sidecar

WORKDIR /app
USER app

ENV TMPDIR=/tmp
ENV TYPST_BIN=/usr/local/bin/typst
ENV MJML_NODE_BIN=/usr/local/bin/node
ENV MJML_DIR=/opt/mjml
ENV ARTIFACT_FONT_PATH=/usr/share/fonts/truetype/liberation2
ENV MCP_CREDENTIALS_PATH=/var/mcp/credentials/credentials.json
ENV MCP_SIDECAR_CREDENTIALS_PATH=/var/mcp/credentials
ENV MCP_SIDECAR_LOCAL_MCP_TRANSPORT=stdio
ENV MCP_SIDECAR_LOCAL_MCP_COMMAND=/usr/local/bin/run-artifact-stdio.sh
ENV MCP_SIDECAR_MCP_TYPE=artifact
ENV MCP_SIDECAR_LOG_LEVEL=info
ENV MCP_SIDECAR_LOG_ENCODING=json

ENTRYPOINT ["/usr/local/bin/mcp-sidecar", "start"]
