# syntax=docker/dockerfile:1.7

ARG GO_VERSION=1.26.0
FROM golang:${GO_VERSION}-bookworm@sha256:2a0ba12e116687098780d3ce700f9ce3cb340783779646aafbabed748fa6677c AS builder
WORKDIR /src/mcp

COPY shared ./shared
COPY browser/go.mod browser/go.sum ./browser/
WORKDIR /src/mcp/browser
ENV GOTOOLCHAIN=auto
RUN go mod download

WORKDIR /src/mcp
COPY browser ./browser
WORKDIR /src/mcp/browser
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/pool-manager ./cmd/pool-manager

FROM gcr.io/distroless/static-debian12:nonroot@sha256:f5b485ea962d9bd1186b2f6b3a061191539b905b82ec395de78cbfae51f20e35
COPY --chmod=755 --from=builder /out/pool-manager /usr/local/bin/pool-manager

EXPOSE 8090
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/pool-manager"]
