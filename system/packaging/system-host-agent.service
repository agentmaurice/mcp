[Unit]
Description=AgentMaurice governed System host agent
After=local-fs.target

[Service]
Type=simple
User=root
Group=agentmaurice-system
ExecStart=/usr/local/libexec/agentmaurice/system-host-agent
EnvironmentFile=-/etc/agentmaurice/system-host-agent.env
Restart=on-failure
RestartSec=2s
RuntimeDirectory=agentmaurice
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/agentmaurice

[Install]
WantedBy=multi-user.target
