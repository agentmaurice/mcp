{
  "server": {
    "address": ":8084",
    "base_path": "/mcp",
    "keep_alive": true,
    "keep_alive_interval": 15
  },
  "database": {
    "dsn": "postgres://root:password@localhost:5432/rag?sslmode=disable",
    "auto_migrate": true
  },
  "vectorstore": {
    "url": "http://localhost:6333",
    "api_key": "",
    "collection": "rag_chunks",
    "destructive_migration": false
  },
  "llm": {
    "provider": "openai",
    "api_key": "your-openai-api-key",
    "base_url": "",
    "model": "gpt-4o-mini",
    "embedding_model": "text-embedding-3-small",
    "embedding_retry_max_attempts": 4,
    "embedding_retry_base_delay_ms": 400,
    "embedding_retry_max_delay_ms": 8000
  },
  "logging": {
    "level": "info",
    "enable_file": false,
    "log_dir": "./logs"
  },
  "detection": {
    "semantic_threshold": 0.9,
    "cv_threshold": 0.85,
    "identifiability_warn": 0.5,
    "identifiability_block": 0.8
  },
  "buffer": {
    "enabled": false,
    "service_url": "http://agentmaurice:3000/api/v1/buffer",
    "token": "your-mcp-buffer-token",
    "namespace": "rag",
    "soft_threshold": 524288,
    "hard_threshold": 2097152,
    "default_ttl": 600
  },
  "runtime": {
    "role": "all"
  },
  "queue": {
    "enabled": false,
    "type": "nats_jetstream",
    "nats": {
      "url": "nats://localhost:4222",
      "subject": "rag.ingest.jobs",
      "queue_group": "rag.ingest.workers",
      "stream": "RAG_INGEST_JOBS",
      "durable": "rag-ingest-consumer",
      "create_stream": true,
      "ack_wait_seconds": 900,
      "max_deliver": 10,
      "dlq_enabled": true,
      "dlq_subject": "rag.ingest.jobs.dlq",
      "dlq_stream": "RAG_INGEST_JOBS_DLQ",
      "dlq_create_stream": true,
      "dlq_advisory_group": "rag.ingest.dlq.republisher"
    }
  },
  "retrieval": {
    "mode": "float",
    "binary_candidates": 1000,
    "enable_float_fallback": true
  }
}
