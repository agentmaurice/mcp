{
	"server": {
		"address": ":8084",
		"base_path": "/mcp",
		"keep_alive": true,
		"keep_alive_interval": 15
	},
	"database": {
		"dsn": "postgres://root:root@127.0.0.1:5432/rag?sslmode=disable",
		"auto_migrate": true
	},
	"vectorstore": {
		"url": "http://localhost:6333",
		"api_key": "",
		"collection": "rag_chunks",
		"destructive_migration": false
	},
	"llm": {
		"provider": "openai",
		"api_key": "",
		"base_url": "",
		"model": "gpt-4",
		"embedding_model": "text-embedding-3-small",
		"embedding_retry_max_attempts": 4,
		"embedding_retry_base_delay_ms": 400,
		"embedding_retry_max_delay_ms": 8000
	},
	"logging": {
		"level": "debug",
		"enable_file": true,
		"log_dir": "./logs"
	},
	"detection": {
		"semantic_threshold": 0.9,
		"cv_threshold": 0.85,
		"identifiability_warn": 0.5,
		"identifiability_block": 0.8
	},
	"buffer": {
		"enabled": false,
		"service_url": "http://localhost:3000/api/v1/buffer",
		"token": "",
		"namespace": "rag",
		"soft_threshold": 524288,
		"hard_threshold": 2097152,
		"default_ttl": 600
	},
	"retrieval": {
		"mode": "binary_int8",
		"binary_candidates": 1000,
		"enable_float_fallback": true
	}
}
